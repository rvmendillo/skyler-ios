{
  "manifest_version": 3,
  "name": "REYDL Download Handoff",
  "version": "1.0.0",
  "description": "Hand download-style links from Safari to the REYDL accelerated download manager.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Send to REYDL",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
